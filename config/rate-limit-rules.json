{
  "rules": [
    {
      "path": "/public",
      "rules": [
        {
          "strategy": "fixed_window",
          "windowMs": 60000,
          "limit": 100,
          "keyBy": ["ip"]
        }
      ]
    },
    {
      "path": "/protected",
      "rules": [
        {
          "strategy": "sliding_window",
          "windowMs": 60000,
          "limit": 30,
          "keyBy": ["user", "ip"]
        }
      ]
    },
    {
      "path": "/heavy",
      "rules": [
        {
          "strategy": "token_bucket",
          "windowMs": 60000,
          "limit": 10,
          "burstLimit": 20,
          "refillRate": 0.167,
          "keyBy": ["user", "tenant"]
        }
      ]
    },
    {
      "path": "/api",
      "rules": [
        {
          "strategy": "sliding_window_counter",
          "windowMs": 60000,
          "limit": 200,
          "keyBy": ["ip"]
        }
      ]
    }
  ]
}