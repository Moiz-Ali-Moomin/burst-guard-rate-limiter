NODE_ENV=development
PORT=3000

# Redis connection mode: standalone | cluster | sentinel
REDIS_MODE=standalone
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CONNECT_TIMEOUT=5000
REDIS_COMMAND_TIMEOUT=1000

# Cluster mode: comma-separated host:port pairs
# REDIS_CLUSTER_NODES=node1:6379,node2:6379,node3:6379

# Sentinel mode: master name + comma-separated sentinel host:port pairs
# REDIS_SENTINEL_NAME=mymaster
# REDIS_SENTINEL_HOSTS=sentinel1:26379,sentinel2:26379,sentinel3:26379

RATE_LIMITER_FALLBACK=true
RATE_LIMITER_KEY_PREFIX=rl

# JWT authentication (leave blank to use x-user-id / x-tenant-id headers in dev)
JWT_SECRET=
JWT_ALGORITHM=HS256

# Dynamic Configuration Path
CONFIG_PATH=./config/rate-limit-rules.json

BENCHMARK_URL=http://localhost:3000
BENCHMARK_REQUESTS=500
BENCHMARK_CONCURRENCY=50
